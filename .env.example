# 复制为 .env 并填入真实值。.env 不要提交到 git！

# ---- 对话模型（DeepSeek 为例，OpenAI 兼容协议）----
LLM_API_KEY=sk-xxxx
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_TEMPERATURE=0.0

# ---- Embeddings 模型 ----
# ⚠️ DeepSeek 官方没有 embeddings 接口！chat 与 embeddings 可以是不同厂商
# EMBEDDING_PROVIDER 三选一：
#   openai      : OpenAI text-embedding-3-small（需 OpenAI key）
#   siliconflow : 硅基流动，国内直连，OpenAI 兼容（只有 DeepSeek key 时推荐）
#                 填 EMBEDDING_API_KEY + EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
#                 EMBEDDING_MODEL 填 BAAI/bge-m3
#   bge         : 本地模型，免费离线（需 pip install langchain-huggingface，首次自动下载）
#                 EMBEDDING_MODEL 填 BAAI/bge-small-zh-v1.5
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# ---- 向量库 ----
VECTOR_DB_DIR=./data/chroma

# ---- 检索参数（默认值，M1 课一起调）----
RETRIEVER_TOP_K=4
RETRIEVER_SCORE_THRESHOLD=0.3
