# 复制为 .env 并填入真实值。.env 不要提交到 git！

# ---- 对话模型（DeepSeek 为例，OpenAI 兼容协议）----
LLM_API_KEY=sk-xxxx
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_TEMPERATURE=0.0

# ---- Embeddings 模型 ----
# ⚠️ DeepSeek 官方没有 embeddings 接口！chat 与 embeddings 可以是不同厂商
# EMBEDDING_PROVIDER 三选一：
#   openai      : OpenAI text-embedding-3-small（需 OpenAI key）
#   siliconflow : 硅基流动，国内直连，OpenAI 兼容（只有 DeepSeek key 时推荐）
#                 填 EMBEDDING_API_KEY + EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
#                 EMBEDDING_MODEL 填 BAAI/bge-m3
#   bge         : 本地模型，免费离线（需 pip install langchain-huggingface，首次自动下载）
#                 EMBEDDING_MODEL 填 BAAI/bge-small-zh-v1.5
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# ---- 向量库 ----
# VECTOR_BACKEND 二选一：chroma（默认，本地文件）/ milvus（需先起 docker-compose.milvus.yml）
VECTOR_BACKEND=chroma
# chroma 用：向量库落盘目录（相对项目根，代码里会解析成绝对路径）
VECTOR_DB_DIR=./data/chroma
# milvus 用：SDK 连接地址（本机跑 Milvus 时如下；若应用也在容器里，要改成 http://milvus:19530）
MILVUS_URI=http://127.0.0.1:19530

# ---- Rerank 精排（可选但强烈建议）----
# 作用：先向量召回 16 条，再用 cross-encoder 精排取前 4 条，最后按 rerank 分数判定有没有答案。
# 为什么需要：embedding 对中文区分度差（相关块 0.76 / 无关块 0.58，差 0.18 没法设阈值）；
#             rerank 后（相关 0.94 / 无关块 0.001，差 0.94）才能可靠判断"库里有没有答案"。
# 注意：RERANK_API_KEY 留空则自动复用 EMBEDDING_API_KEY（同一家厂商时不必重复填）
RERANK_API_KEY=
RERANK_URL=https://api.siliconflow.cn/v1/rerank
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ---- 检索参数（默认值）----
RETRIEVER_TOP_K=4                 # 精排后最终返回几条
RETRIEVER_RECALL_K=16             # 召回阶段取几条交给 rerank
RETRIEVER_SCORE_THRESHOLD=0.2     # embedding 分数门槛（粗筛）
RERANK_SCORE_THRESHOLD=0.1        # rerank 分数门槛（低于它就当作"库里没有答案"）
